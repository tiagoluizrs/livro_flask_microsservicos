# Copie este arquivo para ".env" e preencha com os seus valores.

FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=troque-essa-chave-em-producao

# Banco de dados (separado do livro_flask)
MYSQL_USER=root
MYSQL_PASSWORD=123
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=livro_flask_microsservicos

# Endereço da API do projeto principal (livro_flask)
LIVRO_FLASK_URL=http://localhost:8000
LIVRO_FLASK_EMAIL=
LIVRO_FLASK_PASSWORD=
# Mesma SECRET_KEY usada no .env do livro_flask
LIVRO_FLASK_SECRET_KEY=

# Servidor gRPC do livro_flask e forma de consulta de produtos (rest ou grpc)
LIVRO_FLASK_GRPC_HOST=localhost:50051
LIVRO_FLASK_CLIENT=rest

# Mensageria (capítulos 15 e 16)
RABBITMQ_HOST=localhost
RABBITMQ_USER=estoque
RABBITMQ_PASSWORD=troque-essa-senha
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
